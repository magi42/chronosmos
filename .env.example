CHRONOSMOS_SECRET_KEY=replace-with-a-long-random-secret
CHRONOSMOS_DATA_DIR=/var/lib/chronosmos
CHRONOSMOS_DATABASE_URL=postgresql:///chronosmos?user=chronosmos
CHRONOSMOS_SECURE_COOKIES=1
CHRONOSMOS_TRUST_PROXY=1
CHRONOSMOS_HOSTS=chronosmos.magi.fi,localhost,127.0.0.1

# Optional AI assistant; real values belong only in private environment files.
OPENAI_API_KEY=
